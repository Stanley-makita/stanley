# Supabase — copiar do painel: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role — usado apenas na Edge Function aceitar-convite
# NUNCA expor no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Webhooks externos
# Use este valor na URL do webhook do Uazapi: /api/bot/whatsapp/webhook?token=...
UAZAPI_WEBHOOK_TOKEN=troque-por-um-token-longo-e-aleatorio

# URL pública do app — usada para gerar links de confirmação enviados por e-mail
NEXT_PUBLIC_APP_URL=https://fonti.app.br

# SMTP — envio de e-mails (Hostinger ou outro provedor)
# host: smtp.hostinger.com | porta: 465 (SSL) ou 587 (STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@seudominio.com.br
SMTP_PASS=sua-senha-smtp-aqui
EMAIL_FROM=seu-email@seudominio.com.br
EMAIL_FROM_NAME=Fonti

# Web Push (notificações mesmo com o Fonti fechado) — gerar uma vez com
# `npx web-push generate-vapid-keys`. Pública vai pro navegador (client-side),
# privada NUNCA deve levar o prefixo NEXT_PUBLIC_ (só server-side).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Fase 5 do push (lead atribuído, fase avançada, etc. via Database Webhook do
# Supabase) — segredo compartilhado que só o painel do Supabase deve saber,
# pra /api/push/dispatch recusar chamadas de qualquer outro lugar.
PUSH_DISPATCH_SECRET=
